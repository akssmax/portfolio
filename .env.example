# Sanity CMS — copy to .env.local and fill in your project values
# Create a project at https://sanity.io/manage

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Optional: for seed script and draft preview
SANITY_API_WRITE_TOKEN=

# LLM provider — server-only (never prefix with VITE_)
# LLM_PROVIDER=auto|openrouter|mistral (auto prefers OpenRouter when its key is set)
LLM_PROVIDER=auto

# OpenRouter — free models via openrouter/free (recommended while Mistral free tier is limited)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
# Comma-separated fallbacks when the primary model is rate-limited (OpenRouter models[] routing)
# OPENROUTER_CHAT_MODEL_FALLBACKS=openrouter/free,google/gemma-3-12b-it:free,meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free

# Mistral — switch back with LLM_PROVIDER=mistral (re-run npm run build:rag after switching)
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=ministral-8b-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Gen UI engine: legacy (tool calls) | openui (OpenUI Lang streaming)
GENUI_ENGINE=legacy

# Optional: override Gen UI model (defaults to the same model as chat — MISTRAL_CHAT_MODEL / OPENROUTER_CHAT_MODEL)
# MISTRAL_GENUI_MODEL=

# Optional: max tokens for OpenUI Gen UI streaming (default 2500)
# GEN_UI_MAX_TOKENS=2500

# Optional: cap upstream chat timeout on Vercel (milliseconds)
# VERCEL_CHAT_TIMEOUT_MS=55000

# Private resume builder at /resume (server-only — never prefix with VITE_)
RESUME_BUILDER_SECRET=

# Brave Search API — server-only (never prefix with VITE_)
# Free tier: https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=

# PostHog Analytics — client-side (prefixed with VITE_)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://t.akshaysaini.xyz


