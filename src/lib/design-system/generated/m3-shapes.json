    "templates": {
      "M3Shape": "\"use client\"\n\nimport type { ComponentProps as PlaygroundComponentProps } from \"react\"\nimport { Star } from \"lucide-react\";\n\nimport { M3Shape, M3ShapeClip, M3ShapeIcon, M3ShapeImage, M3ShapePlaceholder } from \"@/components/m3-shapes\";\n\nconst playgroundProps: Partial<PlaygroundComponentProps<typeof M3Shape>> = /*__DS_PROPS__*/ {}\n\n\nexport function M3ShapePropDemo() {\n  return (\n    <div className=\"grid w-full max-w-lg grid-cols-2 gap-8 2xl:grid-cols-3\">\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3Shape shape=\"circle\" className=\"size-24\" {...playgroundProps} />\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3Shape\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapeIcon shape=\"sunny\" className=\"size-24\">\n          <Star className=\"size-9\" />\n        </M3ShapeIcon>\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapeIcon\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapeImage\n          shape=\"heart\"\n          className=\"size-24\"\n          src=\"/images/portraits/01.webp\"\n          alt=\"Akshay Saini\"\n        />\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapeImage\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapePlaceholder\n          shape=\"hexagon\"\n          className=\"size-24\"\n          label=\"Preview\"\n        />\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapePlaceholder\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapeClip shape=\"arch\" className=\"size-24\">\n          <div className=\"size-full bg-primary/20\" />\n        </M3ShapeClip>\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapeClip\n        </span>\n      </div>\n    </div>\n  )\n}",
      "M3ShapeClip": "\"use client\"\n\nimport type { ComponentProps as PlaygroundComponentProps } from \"react\"\nimport { Star } from \"lucide-react\";\n\nimport { M3Shape, M3ShapeClip, M3ShapeIcon, M3ShapeImage, M3ShapePlaceholder } from \"@/components/m3-shapes\";\n\nconst playgroundProps: Partial<PlaygroundComponentProps<typeof M3ShapeClip>> = /*__DS_PROPS__*/ {}\n\n\nexport function M3ShapePropDemo() {\n  return (\n    <div className=\"grid w-full max-w-lg grid-cols-2 gap-8 2xl:grid-cols-3\">\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3Shape shape=\"circle\" className=\"size-24\" />\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3Shape\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapeIcon shape=\"sunny\" className=\"size-24\">\n          <Star className=\"size-9\" />\n        </M3ShapeIcon>\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapeIcon\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapeImage\n          shape=\"heart\"\n          className=\"size-24\"\n          src=\"/images/portraits/01.webp\"\n          alt=\"Akshay Saini\"\n        />\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapeImage\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapePlaceholder\n          shape=\"hexagon\"\n          className=\"size-24\"\n          label=\"Preview\"\n        />\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapePlaceholder\n        </span>\n      </div>\n      <div className=\"flex flex-col items-center gap-4\">\n        <M3ShapeClip shape=\"arch\" className=\"size-24\">{playgroundProps.children ?? <>\n          <div className=\"size-full bg-primary/20\" />\n        </>}</M3ShapeClip>\n        <span className=\"font-mono text-[10px] text-muted-foreground\">\n          M3ShapeClip\n        </span>\n      </div>\n    </div>\n  )\n}",
